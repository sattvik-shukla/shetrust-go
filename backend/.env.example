# ── SheTrust Go Backend ──────────────────────────────────────────────
# Copy this file to .env (in this folder, or the project root) and fill it in.
# Real environment variables always win over anything set here.

PORT=5000

# MongoDB connection string.
# Local:  mongodb://localhost:27017/shetrust
# Atlas:  https://cloud.mongodb.com -> New Project -> Free M0 Cluster
#         -> Connect -> Drivers -> copy the URI, then replace the
#         <username> and <password> placeholders.
MONGODB_URI=mongodb://localhost:27017/shetrust

# Secret used to sign login tokens. Use a long random string in production.
# Keep the SAME value the old Node backend used and existing tokens keep
# working — it is the standard HS256 algorithm either way.
JWT_SECRET=shetrust_dev_jwt_secret_replace_in_production

# Where the frontend is served from, for CORS.
# Leave empty during local development: the server then allows
# http://localhost:3000 automatically.
# In production set it to your deployed URL, e.g. https://shetrust.vercel.app
FRONTEND_URL=
